# Configuration de l'authentification des serveurs MCP du cabinet.
#
# Ce fichier est un MODELE. Ne jamais y ecrire de valeur reelle, et ne jamais versionner
# un .env (il est dans .gitignore).
#
# Par defaut, TOUT EST DESACTIVE : sans MCP_AUTH_MODE, le serveur se comporte comme
# avant, endpoints MCP ouverts. C'est l'etat actuel des quatre serveurs.

# off (defaut, neutre) | jetons (jetons d'administration seuls) | entra (Entra ID)
# MCP_AUTH_MODE=entra

# --- Mode « jetons » : rien d'autre que MCP_ADMIN_TOKENS n'est necessaire ---
# Aucune configuration Entra, aucune metadonnee publiee, pas de resource_metadata dans
# le 401. Le serveur REFUSE DE DEMARRER si la liste est vide ou si un jeton fait moins
# de 32 caracteres : dans ce mode, elle est la seule barriere.
# MCP_AUTH_MODE=jetons
# MCP_ADMIN_TOKENS=<secrets.token_urlsafe(32)>

# --- Valeurs de l'annuaire Entra ID du cabinet (obligatoires en mode entra) ---
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# A NE PAS POSER. Un jeton v2.0 porte toujours le client ID en aud : le defaut est
# juste. api://<client-id> et la ressource canonique sont de toute facon acceptes aussi.
# La ligne de controle du premier jeton valide (journal legi_mcp_auth.validation)
# permet de le constater en preproduction.
# ENTRA_AUDIENCE=

# Portee deleguee exigee dans la revendication scp. A POSER : une portee par serveur,
# le nom exact de la portee exposee sur l'inscription d'application.
# ENTRA_SCOPE_REQUIS=mcp.access

# Restriction par groupe (facultatif) : GUID separes par des virgules. A NE PAS POSER
# tant que groupMembershipClaims vaut null dans le manifeste : sans cette revendication,
# aucun jeton ne porte `groups` et TOUT serait refuse.
# ENTRA_GROUPES_AUTORISES=00000000-0000-0000-0000-000000000000

# --- URL publique du serveur (obligatoire en mode entra) ---
# LA RACINE du service, en HTTPS, sans barre finale et SANS /mcp : le paquet ajoute
# lui-meme le chemin du transport pour former la ressource <MCP_PUBLIC_URL>/mcp, qui
# sert au champ `resource` des metadonnees, a la portee publiee et a l'en-tete
# WWW-Authenticate.
#
#   bon     MCP_PUBLIC_URL=https://mcp.example.com
#   mauvais MCP_PUBLIC_URL=https://mcp.example.com/mcp   -> ressource .../mcp/mcp,
#           refusee par Entra (AADSTS9010010). Le serveur refuse de demarrer.
# MCP_PUBLIC_URL=https://mcp.example.com

# --- Jetons statiques (Claude Code, sonde, tests) ---
# Generer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# Liste separee par des virgules, pour permettre une rotation sans coupure.
# MCP_ADMIN_TOKENS=
