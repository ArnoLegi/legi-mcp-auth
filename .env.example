# Configuration de l'authentification des serveurs MCP du cabinet.
#
# Ce fichier est un MODELE. Ne jamais y ecrire de valeur reelle, et ne jamais versionner
# un .env (il est dans .gitignore).
#
# Par defaut, TOUT EST DESACTIVE : sans MCP_AUTH_MODE, le serveur se comporte comme
# avant, endpoints MCP ouverts. C'est l'etat actuel des quatre serveurs.

# off (defaut, neutre) | jetons (jetons d'administration seuls) | entra (Entra ID)
# MCP_AUTH_MODE=entra

# --- Mode « jetons » : rien d'autre que MCP_ADMIN_TOKENS n'est necessaire ---
# Aucune configuration Entra, aucune metadonnee publiee, pas de resource_metadata dans
# le 401. Le serveur REFUSE DE DEMARRER si la liste est vide ou si un jeton fait moins
# de 32 caracteres : dans ce mode, elle est la seule barriere.
# MCP_AUTH_MODE=jetons
# MCP_ADMIN_TOKENS=<secrets.token_urlsafe(32)>

# --- Valeurs de l'annuaire Entra ID du cabinet (obligatoires en mode entra) ---
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Audience attendue dans le jeton. Defaut : ENTRA_CLIENT_ID. La forme
# api://<client-id> est acceptee dans tous les cas.
# ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000

# Portee delegue exigee dans la revendication scp.
# ENTRA_SCOPE_REQUIS=mcp.access

# Restriction par groupe (facultatif) : GUID separes par des virgules.
# ENTRA_GROUPES_AUTORISES=00000000-0000-0000-0000-000000000000

# --- URL publique du serveur (obligatoire en mode entra) ---
# Sert au champ `resource` des metadonnees et a l'en-tete WWW-Authenticate.
# MCP_PUBLIC_URL=https://mcp-eurlex-production.up.railway.app

# --- Jetons statiques (Claude Code, sonde, tests) ---
# Generer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# Liste separee par des virgules, pour permettre une rotation sans coupure.
# MCP_ADMIN_TOKENS=
